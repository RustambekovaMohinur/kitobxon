# ===================================================
# MutolaaID Konfiguratsiyasi (Environment Variables)
# ===================================================

# PostgreSQL / Neon DB ulanish manzili
DATABASE_URL="postgresql://neondb_owner:npg_sample@ep-sample.eu-central-1.aws.neon.tech/mutolaaid?sslmode=require"

# Autentifikatsiya uchun JWT maxfiy kaliti (kamida 32 ta belgi)
JWT_SECRET="mutolaaid_production_jwt_secret_key_secure_2026_salt"

# Telegram Bot Token (@BotFather orqali olingan)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Telegram Bot username (@kitobxon_rasmiy_bot)
TELEGRAM_BOT_USERNAME="kitobxon_rasmiy_bot"

# Dastur web manzili
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Gemini AI API kaliti (Kitoblar katalogini avtomatik tahlil va import qilish uchun)
GEMINI_API_KEY="your_gemini_api_key_here"
